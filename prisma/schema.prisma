generator client {
  // Prisma Client hasil generate disimpan pada folder generated.
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // URL koneksi database dibaca dari konfigurasi Prisma, bukan ditulis di schema ini.
  provider = "postgresql"
}

// Pilihan tetap yang dipakai untuk kategori, jenis, status project, dan peran user.

enum KategoriProject {
  FS
  CR_FORM
  AIR_FORM
  IC_FORM
  SC_FORM
}

enum JenisProject {
  NEW
  ADDENDUM
}

enum ProjectStatus {
  DRAFT
  INISIASI
  ON_PROGRESS
  PENDING
  ON_HOLD
  SELESAI
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  VIEWER
  BUSINESS_PARTNER
}

enum TahapKomite {
  PRA_KOMITE
  KOMITE_TI_B
  KOMITE_TI_A
}

enum StatusTahapan {
  PLANNED
  ON_PROGRESS
  SELESAI
}

enum Prioritas {
  LOW
  MEDIUM
  HIGH
}

// Data referensi untuk mengisi dropdown dan relasinya ke project.

model ProjectManager {
  id       String    @id 
  nama     String    @unique
  projects Project[]
}

model BusinessPartner {
  id       String    @id 
  nama     String    @unique
  projects Project[]
}

model Unit {
  id       Int       @id @default(autoincrement())
  nama     String    @unique
  projects Project[]
}

// Akun pengguna aplikasi; email menjadi identitas unik untuk login.

model User {
  id           String   @id
  nama         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PROJECT_MANAGER)
  createdAt    DateTime @default(now())
}

// Data utama project dan relasinya ke data master, dokumen, serta riwayat update.
model Project {
  id            Int             @id @default(autoincrement())
  kategori      KategoriProject
  jenis         JenisProject
  kodeProject   String?         @unique
  nama          String
  deskripsi     String
  pmId          String
  pm            ProjectManager  @relation(fields: [pmId], references: [id])
  bpId          String
  bp            BusinessPartner @relation(fields: [bpId], references: [id])
  unitId        Int
  unitPengusul  Unit            @relation(fields: [unitId], references: [id])
  ownerPic      String
  tanggalProject DateTime       @db.Date
  targetGoLive  DateTime?       @db.Date
  status        ProjectStatus   @default(INISIASI)
  prioritas     Prioritas      @default(MEDIUM)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  documents     Document[]
  updates       ProjectUpdate[]
  stages        ProjectStage[]

  @@index([status])
  @@index([nama])
}

// Metadata file yang diunggah; file terkait ikut terhapus jika project dihapus.
model Document {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  namaFile   String
  pathFile   String
  ukuran     Int
  tipe       String
  uploadedAt DateTime @default(now())
}

// Catatan perkembangan project yang tersimpan sebagai riwayat terpisah.
model ProjectUpdate {
  id           Int           @id @default(autoincrement())
  projectId    Int
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tanggalInput DateTime      @default(now())
  status       ProjectStatus
  aktivitas    String        // Aktivitas / Progress / Outcome
  kendala      String?       // Kendala / Issue
  nextAction   String

  @@index([projectId, tanggalInput])
}

model ProjectStage {
  id             Int           @id @default(autoincrement())
  projectId      Int
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tahap          TahapKomite
  tanggalRencana DateTime?     @db.Date
  status         StatusTahapan @default(PLANNED)
  catatan        String?

  @@unique([projectId, tahap])
}